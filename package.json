{
  "name": "wordforge-arena",
  "version": "1.0.0",
  "description": "Mundo 3D multiplayer com criacoes por voz e IA",
  "main": "desktop/main.cjs",
  "author": "WordForge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win portable --x64",
    "vendor": "esbuild scripts/three-entry.js --bundle --format=iife --minify --outfile=web/vendor/three.js"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "esbuild": "^0.25.12",
    "three": "^0.181.2"
  },
  "build": {
    "appId": "com.wordforge.arena",
    "productName": "WordForge 3D",
    "directories": {
      "output": "build/windows"
    },
    "files": [
      "web/**/*",
      "desktop/**/*",
      "server.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "WordForge-3D-Windows.exe"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
