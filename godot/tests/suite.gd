extends SceneTree
const Parser=preload("res://scripts/creation/intent_parser.gd")
const Cost=preload("res://scripts/creation/cost_calculator.gd")
const Validator=preload("res://scripts/creation/creation_validator.gd")
const World=preload("res://scripts/voxel/voxel_world.gd")
var failures=[]
var checks=0
func check(value: bool,message: String) -> void:
 checks+=1
 if not value:failures.append(message);push_error(message)
func _initialize() -> void:call_deferred("run")
func run() -> void:
 for text in ["Quero um cubo","Quero cinco cubos","Quero um cubo gigante","Quero um pato voador","Quero tres patos orbitando","Quero um robo que me siga","Quero uma torre que lanca bolas","Quero um portal","Quero voar","Quero um jetpack","Quero um buraco negro","Quero uma parede"]:
  var g=Parser.parse(text);check(g.ok,"Parse: "+text)
  if g.ok:check(Cost.calculate(g)>0,"Positive cost: "+text)
 var accents=Parser.parse("Quero três patos gigantes que ficam orbitando minha cabeça e lançam bolinhas coloridas")
 check(accents.ok and accents.quantity==3 and "orbit" in accents.mods,"Accents and natural syntax")
 check(Parser.parse("azul voador robô").kind=="robot","Out of order modifiers")
 check(not Parser.parse("robô com confabulador").ok,"Unknown modifier refused explicitly")
 var outlets=Parser.parse("um lançador de três saídas que dispara cubos de gelatina")
 check(outlets.ok and outlets.quantity==1 and outlets.emitter.count==3 and outlets.emitter.elastic,"Visible triple emitter with elastic cubes")
 var a=Parser.parse("um cubo que lanca passaros");var b=Parser.parse("um passaro que lanca cubos")
 check(a.kind=="cube" and a.emitter.kind=="pigeon","Cube emits birds")
 check(b.kind=="pigeon" and b.emitter.kind=="cube","Bird emits cubes")
 var duck=Parser.parse("Quero tres patos gigantes que ficam orbitando minha cabeca e lancam bolinhas coloridas")
 check(duck.ok and duck.quantity==3 and duck.scale==2.4 and "orbit" in duck.mods and duck.emitter.kind=="sphere","Composable duck example")
 var robot=Parser.parse("Quero um robo voador que lanca bolas de tinta")
 check(robot.ok and robot.kind=="robot" and "fly" in robot.mods and robot.emitter.paint,"Robot flying paint emitter")
 check(Parser.parse("Quero um cubo").quantity==1,"Single")
 check(Parser.parse("Quero cinco cubos").quantity==5,"Plural")
 for phrase in ["Crie um robo voador","Faz um robo que voa","Eu quero um robo que consiga voar","Me da um robo com propulsao"]:
  var g=Parser.parse(phrase);check(g.ok and g.kind=="robot" and "fly" in g.mods,"Synonym "+phrase)
 check(not Parser.parse("um elefante quantum").ok,"Unknown entity refused")
 check(not Parser.parse("quero um robo que lanca confabulacoes").ok,"Unknown projectile refused")
 check(not Parser.parse("cinquenta " .repeat(60)).ok,"Long request refused")
 check(not Parser.parse("quero oito cubos").ok,"Count limited")
 check(not Parser.parse("cubos infinitos").ok,"Recursive request refused")
 var g=Parser.parse("cubo");g.cost=Cost.calculate(g)
 check(Validator.validate(g,0,0).contains("insuficiente"),"Matter refusal")
 check(Validator.validate(g,100,0).is_empty(),"Affordable creation")
 check(not Validator.validate(g,100,24).is_empty(),"Entity cap")
 var w=World.new();root.add_child(w);w.blocks[Vector3i.ZERO]=0;w.blocks[Vector3i.RIGHT]=0;w.dirty[Vector3i.ZERO]=true;w.rebuild_all()
 check(w.blocks.size()==2 and w.chunks.size()==1,"Two blocks in one mesh/collider chunk")
 check(w.built_faces==10,"Internal faces culled")
 w.set_block(Vector3i.ZERO,-1);w.rebuild_all()
 check(not w.blocks.has(Vector3i.ZERO) and w.chunks.size()==1,"Geometry and collision rebuilt after removal")
 var changes=w.encoded_changes();var w2=World.new();root.add_child(w2);w2.blocks[Vector3i.ZERO]=0;w2.apply_changes(changes)
 check(not w2.blocks.has(Vector3i.ZERO),"Late join terrain delta")
 w.queue_free();w2.queue_free()
 var main=load("res://scenes/main.tscn").instantiate();root.add_child(main);main._start_solo(false)
 for i in range(70):await physics_frame
 var p=main.players[1]
 check(p.position.y> -1 and p.position.y<2,"Player stands on voxel collision")
 check(p.matter==0,"Starts without matter")
 p.camera.rotation.x=-1.0
 var old_blocks=main.world.blocks.size()
 main._use(1,.35,true)
 check(p.matter==5 and main.world.blocks.size()<old_blocks,"Actual physics ray extraction removes a voxel and credits matter")
 main._create_for(1,"robo voador");check(main.entities.size()==0 and p.matter==5,"No creation without resources")
 p.matter=500;main._create_for(1,"robo voador que me siga")
 check(main.entities.size()==1 and p.matter<500,"Creation spends resources and binds physics")
 var before=p.matter;main._create_for(1,"quero voar")
 check(p.ability=="fly" and p.ability_time>0 and p.matter<before,"Ability is functional and priced")
 var e=main.entities.values()[0];check(e is RigidBody3D and e.get_children().size()>3,"Created body has model and physics")
 print("VOXMATERIA_TESTS: %d checks; %d failures" % [checks,failures.size()])
 for message in failures:print("FAIL: "+message)
 quit(0 if failures.is_empty() else 1)
